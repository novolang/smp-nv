// smp — the Bluetooth Security Manager Protocol, as a state machine
// that performs nothing.
//
// The packet codec and the failure messages have bodies; the state
// machine is still a `todo()` and the README says why.
//
// Core Vol 3 Part H.  SMP rides over L2CAP on CID 0x0006 and pairs two
// devices: it negotiates a method, exchanges confirms and nonces,
// derives a key, and distributes whatever the two sides agreed to
// distribute.  All of that is arithmetic and bookkeeping, and none of
// it touches a radio — which is why it can be a package rather than a
// layer of a stack.
//
// The whole surface is `[]`.  Pairing needs randomness, a clock and a
// link, and this package asks for none of them: it ASKS, through
// `Action`, and the host does it and feeds the answer back.

use std.list
use p256

// The L2CAP channel identifier SMP runs on (§ 3.1).
pub const CID = 0x0006

// Which side of the pairing this instance is.
//
// The initiator is the central that sends Pairing_Request; the
// responder is the peripheral that answers.  A peripheral may ask to be
// paired with by sending a Security_Request, which `begin` does for a
// responder, but it is still the responder.
pub enum Role
    Initiator
    Responder

// What the device can show and what it can be told (§ 3.3.2).
//
// Together with the peer's, this decides the pairing method, which is
// why `method` can only be answered after a Pairing_Response has been
// exchanged.
pub enum IoCapability
    DisplayOnly
    DisplayYesNo
    KeyboardOnly
    NoInputNoOutput
    KeyboardDisplay

// Which keys a side offers to distribute (§ 3.6.1).
//
// `link` is the BR/EDR cross-transport link key; a device with no
// BR/EDR radio leaves it false.
pub struct KeyDistribution
    enc: Bool
    id: Bool
    sign: Bool
    link: Bool

// What this device asks for in a Pairing_Request or Response.
//
// `max_key_size` is in octets, 7 to 16; the two sides take the smaller,
// and a peer that asks for less than this device's own minimum gets
// `EncryptionKeySize`.  `secure_connections` is the SC bit of AuthReq
// and is what chooses between the two pairing families below.
pub struct Features
    bonding: Bool
    mitm: Bool
    secure_connections: Bool
    keypress: Bool
    ct2: Bool
    oob: Bool
    max_key_size: Int
    initiator_keys: KeyDistribution
    responder_keys: KeyDistribution

// The pairing method the two sides' capabilities selected (§ 2.3.5.1).
//
// `NumericComparison` exists only under LE Secure Connections; a legacy
// pairing between two displays gets `JustWorks` instead, which is the
// reason SC is worth having.
pub enum Method
    JustWorks
    PasskeyEntry
    NumericComparison
    OutOfBand

// Why pairing stopped, in the specification's own codes (§ 3.5.5).
//
// These are the values a Pairing_Failed PDU carries, so this enum is
// both this package's error type and part of the wire format.  That is
// deliberate: a decode that fails has, by construction, already worked
// out what to send back.
pub enum Failure
    PasskeyEntryFailed
    OobNotAvailable
    AuthenticationRequirements
    ConfirmValueFailed
    PairingNotSupported
    EncryptionKeySize
    CommandNotSupported
    UnspecifiedReason
    RepeatedAttempts
    InvalidParameters
    DhKeyCheckFailed
    NumericComparisonFailed
    BrEdrPairingInProgress
    CrossTransportKeyNotAllowed
    KeyRejected

// What went wrong, in words, for a caller that logs rather than
// branches.
//
// `Result<_, Failure>` requires it: SPEC § 3.4 admits a `Result` error
// type only if it implements `Error`.
impl Error for Failure
    fn message(self) -> Str
        match self
            PasskeyEntryFailed          => "the passkey entry failed"
            OobNotAvailable             => "out-of-band data is not available"
            AuthenticationRequirements  => "the authentication requirements cannot be met"
            ConfirmValueFailed          => "the confirm value did not match"
            PairingNotSupported         => "pairing is not supported"
            EncryptionKeySize           => "the encryption key size is too small"
            CommandNotSupported         => "the command is not supported"
            UnspecifiedReason           => "pairing failed for an unspecified reason"
            RepeatedAttempts            => "too many pairing attempts too soon"
            InvalidParameters           => "a pairing parameter is invalid"
            DhKeyCheckFailed            => "the DHKey check value did not match"
            NumericComparisonFailed     => "the numeric comparison failed"
            BrEdrPairingInProgress      => "a BR/EDR pairing is in progress"
            CrossTransportKeyNotAllowed => "cross-transport key derivation is not allowed"
            KeyRejected                 => "the key was rejected"

// The key material one side distributed to the other (§ 3.6).
//
// Every field is optional because what arrives is what the two sides
// negotiated: an LE Secure Connections bond distributes no LTK at all,
// because both sides derived the same one from f5 and there is nothing
// to send.  `ediv` and `rand` are legacy's way of naming a stored LTK
// and are absent under SC for the same reason.
pub struct Keys
    ltk: ?[u8]
    ediv: ?Int
    rand: ?[u8]
    irk: ?[u8]
    identity_address: ?[u8]
    identity_address_type: ?Int
    csrk: ?[u8]

// What the host must do next.
//
// This enum is the whole reason this package can be `core`.  Every
// effect pairing needs is one of these — a PDU to put on the wire,
// entropy to draw, a person to ask, a link to encrypt, a bond to write
// to flash — and the state machine returns them instead of performing
// them.
pub enum Action
    // Put these bytes on L2CAP CID 0x0006.  The PDU is complete,
    // opcode included, and carries no L2CAP header.
    Send(pdu: [u8])
    // Draw this many bytes of entropy and hand them back through
    // `feed_random`.  The state machine will not advance until they
    // arrive, and it never draws its own — that is the `[rand]` this
    // package does not have.
    NeedRandom(bytes: Int)
    // Ask the person.  For `NumericComparison` the value is six digits
    // to display and confirm; for `PasskeyEntry` it is the passkey to
    // display, or -1 when this side is the one that must type it.
    // Answer through `feed_user`.
    Confirm(method: Method, value: Int)
    // Start link-layer encryption with this key, then report back
    // through `feed_link_encrypted`.  Under legacy the key is the STK;
    // under Secure Connections it is the LTK f5 derived.
    StartEncryption(key: [u8])
    // Pairing succeeded and this is what to persist against the peer's
    // identity.  A device that does not bond may drop it.
    StoreKeys(keys: Keys)
    // Pairing is over and will not resume.  The Pairing_Failed PDU, if
    // one is owed to the peer, arrives as a `Send` before this.
    Failed(reason: Failure)

// The person's answer to a `Confirm` action.
pub enum UserResponse
    // Numeric Comparison: the values matched.  Out of Band: the data
    // is available.
    Confirmed
    // The person said no, or the confirmation timed out.
    Rejected
    // Passkey Entry: the six digits that were typed.
    Passkey(digits: Int)

// Where the procedure is, for a caller that reports rather than drives.
//
// Driving is `feed` and the actions it returns; this is for a status
// line.  It is deliberately coarser than the internal state machine —
// a caller that branched on every wire state would be reimplementing
// the protocol.
pub enum State
    // Nothing in progress.  Fresh, or finished, or disconnected.
    Idle
    // A pairing procedure is under way and waiting on the peer.
    Pairing
    // Waiting for `feed_random`.
    WaitingForRandom
    // Waiting for `feed_user`.
    WaitingForUser
    // Waiting for `feed_link_encrypted`.
    Encrypting
    // The link is encrypted and any agreed keys have been distributed.
    Bonded
    // Over.  The reason is the one that was sent or received.
    Failed(reason: Failure)

// One side's view of a pairing procedure.
//
// Opaque, and a VALUE: a caller holds one per connection and this
// package holds nothing.  Every function that advances it takes one and
// returns another, so a caller that keeps the old one has a snapshot
// rather than a dangling handle.
pub struct Smp
    // Opaque.  A caller that reaches into this has coupled itself to a
    // representation that will change when Secure Connections lands.
    tag: Int

// A state machine and everything the host must do before feeding it
// again.
//
// A struct rather than a tuple for the reason a tuple fails here: its
// components come out only through `match`, and these two are used in
// different places — the caller reassigns one and iterates the other.
//
// The actions are in the order they must happen.  A `Send` before a
// `Failed` is the Pairing_Failed PDU the peer is owed, and reordering
// them puts a device on the air after it has told itself pairing ended.
pub struct PairingStep
    smp: Smp
    actions: [Action]

// ── Driving the procedure ───────────────────────────────────────────

// A state machine that has not started.
//
// `features` is what this device will ask for and accept; `io_caps` is
// what it can show and be told.  Neither can change once pairing has
// begun, which is why they are here rather than on `begin`.
pub fn new(role: Role, features: Features, io_caps: IoCapability) -> Smp
    todo("smp.new")

// Start.
//
// An initiator emits a Pairing_Request.  A responder emits a
// Security_Request, which asks the initiator to start or to encrypt
// with an existing bond — a peripheral cannot pair on its own
// authority.  A responder that intends only to answer never calls this.
pub fn begin(s: Smp) -> PairingStep
    todo("smp.begin")

// Feed one SMP PDU received on CID 0x0006.
//
// `pdu` is the L2CAP payload: the opcode byte and its parameters, with
// no L2CAP header.  A PDU that does not decode, or that is not legal in
// the current state, produces a `Send` of Pairing_Failed and a `Failed`
// rather than a refusal — the peer is owed an answer, and a caller that
// had to turn a `Result` into that PDU itself would be writing the
// protocol twice.
pub fn feed(s: Smp, pdu: [u8]) -> PairingStep
    todo("smp.feed")

// Feed the entropy a `NeedRandom` asked for.
//
// Hand it exactly the number of bytes it asked for, from a source you
// trust.  Feeding fewer, or feeding when none was asked for, produces
// a `Failed(UnspecifiedReason)`: a pairing that continued on short
// entropy would be worse than one that stopped.
pub fn feed_random(s: Smp, bytes: [u8]) -> PairingStep
    todo("smp.feed_random")

// Feed the person's answer to a `Confirm`.
pub fn feed_user(s: Smp, response: UserResponse) -> PairingStep
    todo("smp.feed_user")

// Report that link-layer encryption started with the key a
// `StartEncryption` handed over.
//
// This is what moves a legacy procedure past the STK and lets key
// distribution begin, so a host that starts encryption and forgets to
// say so leaves the peer waiting for keys that never come.
pub fn feed_link_encrypted(s: Smp) -> PairingStep
    todo("smp.feed_link_encrypted")

// Give up, telling the peer why.
//
// Emits the Pairing_Failed PDU as a `Send` and then a `Failed`.  Legal
// in any state; from `Idle` it does nothing, because there is nothing
// to abort.
pub fn abort(s: Smp, reason: Failure) -> PairingStep
    todo("smp.abort")

// Where the procedure is.
pub fn state(s: Smp) -> State
    todo("smp.state")

// The method the two sides' capabilities selected, once both
// Pairing_Request and Pairing_Response have been exchanged.
//
// `None` before that, because the answer depends on what the peer said
// and guessing it early is how a stack ends up displaying a passkey for
// a Just Works pairing.
pub fn method(s: Smp) -> ?Method
    todo("smp.method")

// Whether this procedure gives man-in-the-middle protection.
//
// True only when the selected method actually authenticated the peer —
// Passkey Entry, Numeric Comparison or Out of Band.  Just Works is
// `false` however many devices asked for MITM, which is the fact a
// caller needs before it treats the link as trusted.
pub fn is_authenticated(s: Smp) -> Bool
    todo("smp.is_authenticated")

// The peer's public key, once one has arrived and validated.
//
// `None` under LE Legacy pairing, which has no public keys at all, and
// before Pairing_Public_Key under Secure Connections.  A key that
// arrived and did NOT validate never reaches here: the procedure has
// already failed with `DhKeyCheckFailed`, because a peer's point off
// the curve is the invalid-curve attack and not a thing to hand a
// caller.
//
// This is the one place p256-nv's types appear in this package's public
// surface.  The rest of the curve work — a local key pair from the
// entropy the host feeds in, and the ECDH behind f5 — happens inside
// `feed_random` and `feed`, because a caller that had to run it would
// be holding key material the state machine already has.
pub fn peer_public_key(s: Smp) -> ?p256.PublicKey
    todo("smp.peer_public_key")

// ── The PDUs ────────────────────────────────────────────────────────

// One SMP PDU (§ 3.3 to § 3.6).
//
// The state machine consumes and produces bytes, so a caller never
// needs these; they are `pub` because a packet-capture tool, a test and
// a conformance harness all do, and because a shape a reader can see is
// how they check what the state machine is doing.
pub enum Pdu
    PairingRequest(features: Features, io_caps: IoCapability)
    PairingResponse(features: Features, io_caps: IoCapability)
    PairingConfirm(value: [u8])
    PairingRandom(value: [u8])
    PairingFailed(reason: Failure)
    EncryptionInformation(ltk: [u8])
    MasterIdentification(ediv: Int, rand: [u8])
    IdentityInformation(irk: [u8])
    IdentityAddressInformation(addr_type: Int, addr: [u8])
    SigningInformation(csrk: [u8])
    SecurityRequest(features: Features)
    PairingPublicKey(x: [u8], y: [u8])
    PairingDhKeyCheck(value: [u8])
    KeypressNotification(kind: Int)

// The PDU as its wire bytes: the opcode, then its parameters.
pub fn encode_pdu(pdu: Pdu) -> [u8]
    var out: [u8] = [pdu_opcode(pdu) as u8]
    match pdu
        PairingRequest(f, io)            => push_pairing(var out, f, io)
        PairingResponse(f, io)           => push_pairing(var out, f, io)
        PairingConfirm(v)                => push_all(var out, v)
        PairingRandom(v)                 => push_all(var out, v)
        PairingFailed(r)                 => list.push(out, failure_code(r) as u8)
        EncryptionInformation(k)         => push_all(var out, k)
        MasterIdentification(ediv, rand) =>
            list.push(out, (ediv & 255) as u8)
            list.push(out, ((ediv >>> 8) & 255) as u8)
            push_all(var out, rand)
        IdentityInformation(k)           => push_all(var out, k)
        IdentityAddressInformation(t, a) =>
            list.push(out, t as u8)
            push_all(var out, a)
        SigningInformation(k)            => push_all(var out, k)
        SecurityRequest(f)               => list.push(out, auth_req(f) as u8)
        PairingPublicKey(x, y)           =>
            push_all(var out, x)
            push_all(var out, y)
        PairingDhKeyCheck(v)             => push_all(var out, v)
        KeypressNotification(k)          => list.push(out, k as u8)
    out

// Read a PDU from an L2CAP payload.
//
// The error is the `Failure` the peer is owed, which is what makes this
// worth a `Result`: `CommandNotSupported` for an opcode this package
// does not know, and `InvalidParameters` for one whose length is wrong.
pub fn decode_pdu(bytes: [u8]) -> Result<Pdu, Failure>
    if list.len(bytes) == 0
        Err(InvalidParameters)
    else
        let op = bytes[0] as Int
        let n = list.len(bytes) - 1
        if op == 1 or op == 2
            if n != 6
                Err(InvalidParameters)
            else
                match read_features(bytes, 3)
                    Err(e) => Err(e)
                    Ok(f)  =>
                        match io_capability(bytes[1] as Int)
                            Err(e) => Err(e)
                            Ok(io) => if op == 1
                                Ok(PairingRequest(f, io))
                            else
                                Ok(PairingResponse(f, io))
        else if op == 3
            if n == 16
                Ok(PairingConfirm(tail(bytes, 1)))
            else
                Err(InvalidParameters)
        else if op == 4
            if n == 16
                Ok(PairingRandom(tail(bytes, 1)))
            else
                Err(InvalidParameters)
        else if op == 5
            if n == 1
                Ok(PairingFailed(failure_of(bytes[1] as Int)))
            else
                Err(InvalidParameters)
        else if op == 6
            if n == 16
                Ok(EncryptionInformation(tail(bytes, 1)))
            else
                Err(InvalidParameters)
        else if op == 7
            if n == 10
                Ok(MasterIdentification(bytes[1] as Int | (bytes[2] as Int << 8), tail(bytes, 3)))
            else
                Err(InvalidParameters)
        else if op == 8
            if n == 16
                Ok(IdentityInformation(tail(bytes, 1)))
            else
                Err(InvalidParameters)
        else if op == 9
            if n == 7
                Ok(IdentityAddressInformation(bytes[1] as Int, tail(bytes, 2)))
            else
                Err(InvalidParameters)
        else if op == 10
            if n == 16
                Ok(SigningInformation(tail(bytes, 1)))
            else
                Err(InvalidParameters)
        else if op == 11
            if n == 1
                Ok(SecurityRequest(auth_features(bytes[1] as Int)))
            else
                Err(InvalidParameters)
        else if op == 12
            if n == 64
                Ok(PairingPublicKey(slice(bytes, 1, 33), tail(bytes, 33)))
            else
                Err(InvalidParameters)
        else if op == 13
            if n == 16
                Ok(PairingDhKeyCheck(tail(bytes, 1)))
            else
                Err(InvalidParameters)
        else if op == 14
            if n == 1
                Ok(KeypressNotification(bytes[1] as Int))
            else
                Err(InvalidParameters)
        else
            Err(CommandNotSupported)

// The opcode byte a PDU carries.
pub fn pdu_opcode(pdu: Pdu) -> Int
    match pdu
        PairingRequest(_, _)             => 1
        PairingResponse(_, _)            => 2
        PairingConfirm(_)                => 3
        PairingRandom(_)                 => 4
        PairingFailed(_)                 => 5
        EncryptionInformation(_)         => 6
        MasterIdentification(_, _)       => 7
        IdentityInformation(_)           => 8
        IdentityAddressInformation(_, _) => 9
        SigningInformation(_)            => 10
        SecurityRequest(_)               => 11
        PairingPublicKey(_, _)           => 12
        PairingDhKeyCheck(_)             => 13
        KeypressNotification(_)          => 14

// ── Wire helpers ────────────────────────────────────────────────────

// Append every byte of `src` to `out`.
fn push_all(var out: [u8], src: [u8])
    for b in src
        list.push(out, b)

// `bytes[from..]` as a new list.
fn tail(bytes: [u8], from: Int) -> [u8]
    slice(bytes, from, list.len(bytes))

// `bytes[from..to]` as a new list.
fn slice(bytes: [u8], from: Int, to: Int) -> [u8]
    var out: [u8] = list.with_capacity(to - from)
    for i in from..to
        list.push(out, bytes[i])
    out

fn bit(b: Bool, shift: Int) -> Int
    if b
        1 << shift
    else
        0

// The AuthReq octet of section 3.5.1.
fn auth_req(f: Features) -> Int
    bit(f.bonding, 0) | bit(f.mitm, 2) | bit(f.secure_connections, 3) | bit(f.keypress, 4) | bit(f.ct2, 5)

// The key distribution octet of section 3.6.1.
fn key_dist(k: KeyDistribution) -> Int
    bit(k.enc, 0) | bit(k.id, 1) | bit(k.sign, 2) | bit(k.link, 3)

fn dist_of(v: Int) -> KeyDistribution
    KeyDistribution { enc: (v & 1) != 0, id: (v & 2) != 0, sign: (v & 4) != 0, link: (v & 8) != 0 }

// The five parameters after the opcode that a Pairing_Request and a
// Pairing_Response share: IO capability, OOB flag, AuthReq, maximum
// key size and the two key distribution octets.
fn push_pairing(var out: [u8], f: Features, io: IoCapability)
    list.push(out, io_code(io) as u8)
    list.push(out, bit(f.oob, 0) as u8)
    list.push(out, auth_req(f) as u8)
    list.push(out, f.max_key_size as u8)
    list.push(out, key_dist(f.initiator_keys) as u8)
    list.push(out, key_dist(f.responder_keys) as u8)

fn io_code(io: IoCapability) -> Int
    match io
        DisplayOnly     => 0
        DisplayYesNo    => 1
        KeyboardOnly    => 2
        NoInputNoOutput => 3
        KeyboardDisplay => 4

fn io_capability(v: Int) -> Result<IoCapability, Failure>
    if v == 0
        Ok(DisplayOnly)
    else if v == 1
        Ok(DisplayYesNo)
    else if v == 2
        Ok(KeyboardOnly)
    else if v == 3
        Ok(NoInputNoOutput)
    else if v == 4
        Ok(KeyboardDisplay)
    else
        Err(InvalidParameters)

// The features a Security_Request carries: only AuthReq travels.
fn auth_features(a: Int) -> Features
    Features { bonding: (a & 3) == 1, mitm: (a & 4) != 0, secure_connections: (a & 8) != 0,
               keypress: (a & 16) != 0, ct2: (a & 32) != 0, oob: false, max_key_size: 16,
               initiator_keys: dist_of(0), responder_keys: dist_of(0) }

// The features of a Pairing_Request or Pairing_Response whose OOB flag
// is at offset 2 and whose AuthReq starts at `from - 1`: the bytes are
// `opcode, IO, OOB, AuthReq, MaxKey, InitKeys, RespKeys`.
fn read_features(b: [u8], from: Int) -> Result<Features, Failure>
    let oob = b[2] as Int
    let key = b[4] as Int
    if oob > 1
        Err(InvalidParameters)
    else if key < 7 or key > 16
        Err(InvalidParameters)
    else
        let a = auth_features(b[from] as Int)
        Ok(Features { bonding: a.bonding, mitm: a.mitm, secure_connections: a.secure_connections,
                      keypress: a.keypress, ct2: a.ct2, oob: oob == 1, max_key_size: key,
                      initiator_keys: dist_of(b[5] as Int), responder_keys: dist_of(b[6] as Int) })

fn failure_code(f: Failure) -> Int
    match f
        PasskeyEntryFailed          => 1
        OobNotAvailable             => 2
        AuthenticationRequirements  => 3
        ConfirmValueFailed          => 4
        PairingNotSupported         => 5
        EncryptionKeySize           => 6
        CommandNotSupported         => 7
        UnspecifiedReason           => 8
        RepeatedAttempts            => 9
        InvalidParameters           => 10
        DhKeyCheckFailed            => 11
        NumericComparisonFailed     => 12
        BrEdrPairingInProgress      => 13
        CrossTransportKeyNotAllowed => 14
        KeyRejected                 => 15

// A reserved reason code is read as Unspecified Reason, as section
// 3.5.5 says.
fn failure_of(v: Int) -> Failure
    if v == 1
        PasskeyEntryFailed
    else if v == 2
        OobNotAvailable
    else if v == 3
        AuthenticationRequirements
    else if v == 4
        ConfirmValueFailed
    else if v == 5
        PairingNotSupported
    else if v == 6
        EncryptionKeySize
    else if v == 7
        CommandNotSupported
    else if v == 9
        RepeatedAttempts
    else if v == 10
        InvalidParameters
    else if v == 11
        DhKeyCheckFailed
    else if v == 12
        NumericComparisonFailed
    else if v == 13
        BrEdrPairingInProgress
    else if v == 14
        CrossTransportKeyNotAllowed
    else if v == 15
        KeyRejected
    else
        UnspecifiedReason
